<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================================
     ShopAi 微服务 父工程 POM
     单体拆分：原单体(com.example.demo) → 多模块微服务(com.shopai.*)

     模块清单（逐步添加，当前已建）：
       - shopai-common   公共库
     后续待建模块（拆分时逐一往 <modules> 中添加）：
       - shopai-gateway  网关        (8080)
       - shopai-user     用户/认证   (8081)
       - shopai-product  商品        (8082)
       - shopai-order    订单        (8083)
       - shopai-merchant 商家/评价   (8084)
       - shopai-search   搜索(ES)    (8085)
       - shopai-inventory库存        (8086)

     版本矩阵（2026-10-05 降级为 Spring Boot 3 稳定线）：
       - Spring Boot          3.2.4
       - Spring Cloud         2023.0.1
       - Spring Cloud Alibaba 2023.0.1.0 (Nacos 2.3.2 / Seata 2.0.0)
       - MyBatis-Plus         3.5.8
       - JJWT                 0.12.6
       - Hutool               5.8.34
       - Lombok               1.18.34
     说明：项目 JDK 为 21，Spring Boot 3.2.x 官方支持 JDK 17~21，兼容。
     选 2023.0.1.0 的原因：其内置 Seata 2.0.0 仍为 io.seata 包，
     与业务代码 import io.seata.spring.annotation.GlobalTransactional 一致，无需改代码；
     2023.0.1.3 及之后升级到 Seata 2.1.0（org.apache.seata 包，且不再含该注解），会编译报错。
     ====================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程继承 Spring Boot 官方 parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.shopai</groupId>
    <artifactId>shopai-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ShopAi</name>
    <description>ShopAi 服装商城微服务（由单体拆分而来）</description>

    <!-- ==================== 聚合子模块 ==================== -->
    <modules>
        <!-- 公共库（非服务，最先构建） -->
        <module>shopai-common</module>

        <!-- 网关 -->
        <module>shopai-gateway</module>
        <!-- 业务服务（已建） -->
        <module>shopai-user</module>
        <module>shopai-product</module>
        <module>shopai-inventory</module>
        <module>shopai-order</module>
        <module>shopai-merchant</module>
        <module>shopai-search</module>
        <!-- 秒杀服务（8087）：活动管理 + 独立秒杀库存 + Redis 原子扣减 + MQ 异步下单 -->
        <module>shopai-seckill</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Spring 体系版本（Spring Boot 3 稳定线；三者必须成套，勿单独改） -->
        <spring-boot.version>3.2.4</spring-boot.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <!-- 第三方版本 -->
        <mybatis-plus.version>3.5.8</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <hutool.version>5.8.34</hutool.version>
        <!-- Lombok 显式锁定版本 -->
        <lombok.version>1.18.34</lombok.version>
        <!-- 内部模块版本（与父工程一致） -->
        <shopai-common.version>1.0.0-SNAPSHOT</shopai-common.version>
    </properties>

    <!-- ==================== 依赖管理（子模块按需声明，版本在此统一锁定） ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ============ 内部模块 ============ -->
            <dependency>
                <groupId>com.shopai</groupId>
                <artifactId>shopai-common</artifactId>
                <version>${shopai-common.version}</version>
            </dependency>

            <!-- ============ 第三方 ============ -->
            <!-- MyBatis-Plus（Spring Boot 3/4 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Lombok（显式锁版本；父 pom 的 <dependencies> 与 annotationProcessorPaths 均引用它） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- JJWT（JWT 工具） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- Hutool 工具类 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- Netty BOM 统一锁定版本（修复 GHSA-mfg7-5gfp-c4w3：需 >= 4.2.16.Final 或 >= 4.1.136.Final）
                 注：Spring Boot 3.2 走 Netty 4.1.x 线，故锁定 4.1.136.Final。 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.136.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== 通用依赖（所有业务服务均需，但非强制——子模块可按需排除） ==================== -->
    <dependencies>
        <!-- Lombok（编译期注解处理器，可选；版本显式锁定，避免解析为 unknown） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 统一编译插件：Java 21 + Lombok 注解处理 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- 注意：annotationProcessorPaths 不会继承 dependencyManagement 版本，
                             此处必须显式写 <version>，否则 Maven/IDEA 解析为 unknown，注解处理失效 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 说明：spring-boot-maven-plugin 放在"可独立打包的服务模块"中，
                 公共库/网关/父工程不打包可执行 jar。 -->
        </plugins>
    </build>

    <!-- Spring 快照仓库（原项目保留，便于获取 Spring Boot 4.x 快照） -->
    <repositories>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>
</project>
