# =============================================================================
# ShopAi —— 全栈电商微服务系统
#
# 分三部分：JAVA（Spring Cloud 微服务）、Vue（前端）、Python（AI 助手服务）
# 本文件放在仓库根目录；JAVA/.gitignore 与 Python/.gitignore 各自还有一份，
# 两处规则会叠加生效，不冲突。
#
# 约定：凡「下载的中间件」「构建产物」「运行时数据」「含密钥的文件」一律不入库。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 依赖与构建产物
# -----------------------------------------------------------------------------
# Maven
target/
build/
out/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# 前端
node_modules/
dist/
dist-ssr/
.vite/
.cache/
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
.pytest_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# 2. 下载的中间件（体积大且可重新获取，绝不入库）
# -----------------------------------------------------------------------------
# RabbitMQ 安装目录（约 1.2GB）
Shopmq/
# Nacos 服务端（约 200MB）
nacos2.3.2/
# Seata 服务端（约 200MB）
seata/
# 临时目录里放的是 incubator-seata 源码包，属于误放的下载物
新建文件夹/

# -----------------------------------------------------------------------------
# 3. 中间件运行时数据
# -----------------------------------------------------------------------------
# Redis 集群节点目录：会生成 dump.rdb / appendonly.aof 等持久化文件
ShopRedis/7001/
ShopRedis/7002/
ShopRedis/7003/
ShopRedis/7004/
ShopRedis/7005/
ShopRedis/7006/
# 通用兜底：任何位置的 Redis 持久化文件
dump.rdb
appendonly.aof
nodes.conf

# -----------------------------------------------------------------------------
# 4. 用户上传内容
# -----------------------------------------------------------------------------
# 商品图 / 店铺 Logo / 头像 / 演示视频都是运行时产生的用户数据，不属于源码。
# 若希望「clone 下来就能看到演示图片」，删掉下面两行即可（会多出约 21MB）。
VorI/Images/
VorI/Video/

# -----------------------------------------------------------------------------
# 5. 敏感配置（重要）
# -----------------------------------------------------------------------------
# 真实密钥/口令一律不入库，只提交 *.example 模板
.env
.env.*
!.env.example
*.local.yml
application-local.yml
application-local.yaml
application-prod.yml
*.pem
*.p12
*.key
*.jks
# 数据库导出/备份（表结构与初始化脚本在 JAVA/docs/sql、JAVA/sql 下，需要入库）
*.sql.gz
*.dump
*.dmp

# -----------------------------------------------------------------------------
# 6. 日志与 JVM 崩溃转储
# -----------------------------------------------------------------------------
*.log
logs/
# JVM 内存不足时会生成的崩溃报告与编译器重放数据（本项目确实产生过）
hs_err_pid*.log
replay_pid*.log
*.hprof

# -----------------------------------------------------------------------------
# 7. IDE / 编辑器
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
*.ipr.d
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.classpath
.project
.settings/
.factorypath
.settings
.springBeans
.sts4-cache
nbproject/private/

# -----------------------------------------------------------------------------
# 8. 操作系统
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# -----------------------------------------------------------------------------
# 9. 临时文件与备份
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
*.old
# 项目里遗留的临时/备份文件
JAVA/_deltest.tmp
JAVA/pom.xml.monolith.bak
JAVA/curl

# -----------------------------------------------------------------------------
# 10. 测试与覆盖率
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.cover
*.lcov
test-results/
